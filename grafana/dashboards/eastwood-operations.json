{
  "uid": "eastwood-ops",
  "title": "Eastwood operations",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "eastwood"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Outbound permitted (1 = campaign authorized)",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "eastwood_outbound_permitted"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active agent sessions (must idle at 0)",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "agent_sessions_active"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sessions reaped (abandoned)",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "sum(agent_sessions_reaped_total)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Duplicate terminal events",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "sum(agent_duplicate_terminal_events_total)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbound contact decisions / 5m",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "sum by (channel, result) (increase(eastwood_outbound_contact_decisions_total[5m]))",
          "legendFormat": "{{channel}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Call events / 5m (connected, quoted, booked, DNC)",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "sum by (event_type) (increase(eastwood_agent_events_received_total[5m]))",
          "legendFormat": "{{event_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Leads routed / 5m by action",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "sum by (action) (increase(eastwood_leads_routed_total[5m]))",
          "legendFormat": "{{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Agent brief SMS by result",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "sum by (result) (eastwood_agent_brief_sms_total)",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Policy decisions / 5m",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "sum by (severity, reason) (increase(agent_policy_decisions_total[5m]))",
          "legendFormat": "{{severity}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Turn latency p95 (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_turn_latency_ms_bucket[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scrape targets up",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Estimated spend, last 24 h (USD)",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "sum(increase(eastwood_spend_usd_total[24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Dial attempts per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 31,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "sum(rate(eastwood_outbound_contact_decisions_total{channel=\"dial\",result=\"sent\"}[5m])) * 60"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Budget holds / halts (5 m)",
      "datasource": {
        "type": "prometheus",
        "uid": "eastwood-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 31,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eastwood-prometheus"
          },
          "expr": "sum by (result) (increase(eastwood_outbound_contact_decisions_total{result=~\"budget_.*\"}[5m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
