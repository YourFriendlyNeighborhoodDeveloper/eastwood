# ── Secrets ───────────────────────────────────────────────────────────────────
# Never commit real credentials. Copy .env.example -> .env and fill it in.
.env
.env.*
!.env.example

# ── Private lead data ─────────────────────────────────────────────────────────
# Purchased lead lists contain consumer PII and must never be committed.
# Deliberately NOT ignoring *.csv wholesale: carrier rate sheets are reference
# data and may legitimately be versioned.
Leads_Export_*.csv
*.local.csv
data/private/
exports/private/

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.venv/
venv/

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo
*.egg-info/

# ── Test and coverage artifacts ───────────────────────────────────────────────
coverage/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
desktop.ini
