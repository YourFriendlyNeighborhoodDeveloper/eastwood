# ── Secrets ───────────────────────────────────────────────────────────────────
# Never commit real credentials. Copy .env.example -> .env and fill it in.
.env
.env.*
!.env.example

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.venv/
venv/

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo
*.egg-info/

# ── Test and coverage artifacts ───────────────────────────────────────────────
coverage/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
desktop.ini
