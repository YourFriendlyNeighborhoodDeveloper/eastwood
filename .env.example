# Eastwood environment template.
#
#   cp .env.example .env    then fill in real values.
#
# .env is gitignored. Never commit real credentials.
# Every value below is a placeholder or a safe default.

# ── Deployment ────────────────────────────────────────────────────────────────
# "production" enables the compliance boot guard in eastwood-core:
# starting with APP_ENV=production and BYPASS_TCPA=true is refused.
APP_ENV=development

# ── Compliance ────────────────────────────────────────────────────────────────
# BYPASS_TCPA skips the 8am-9pm local-time calling-window check. Local testing
# only. Leaving this true in production is a TCPA violation per dialed lead.
BYPASS_TCPA=false

# ── National DNC Registry ─────────────────────────────────────────────────────
# A lead may only be auto-dialed when its national_dnc_status is "clear" or
# "exempt". New leads default to "unknown", which is not dialable.
#
# "local_csv" is a blocklist-only stand-in. It can prove a number IS on the
# registry; it cannot attest that one is clear, so on its own it dials nobody.
# Point DNC_SCRUB_PROVIDER at a real registry provider before going live.
# local_csv: blocklist-only stand-in. ftc_registry: official downloaded dataset.
DNC_SCRUB_PROVIDER=local_csv
# local_csv blocklist. Gitignored. Never commit National Registry data.
NATIONAL_DNC_BLOCKLIST_PATH=data/private/national_dnc_blocked.local.csv

# ── ftc_registry provider ─────────────────────────────────────────────────────
# Subscription Account Number and login. Secrets — only a fingerprint is stored.
DNC_SAN=
DNC_REGISTRY_USERNAME=
DNC_REGISTRY_PASSWORD=
# Comma-separated subscribed area codes, e.g. 313,248,586
DNC_AREA_CODES=
# Documented FTC automated-download endpoint (operator-supplied; not scraped).
DNC_REGISTRY_DOWNLOAD_URL=
# Downloaded dataset lives here — under data/private, gitignored.
DNC_DATA_DIRECTORY=data/private/dnc_registry
# A dataset older than this can no longer clear a number. Refresh more often.
DNC_MAX_DATA_AGE_DAYS=31

# Comma-separated E.164 numbers you personally own and consent to be called for
# end-to-end testing. These scrub as "exempt" without a provider — NOT a bypass;
# every other number still fails closed. MUST be empty in production (the boot
# guard refuses to start otherwise).
# DNC_TEST_ALLOWLIST=+15555550100

# ── Lead scoring ──────────────────────────────────────────────────────────────
# Leads at or above HOT auto-dial; WARM auto-dials with express written consent.
# Lowering these to the same value makes every consented lead auto-dial.
SCORE_HOT_THRESHOLD=75
SCORE_WARM_THRESHOLD=50

# ── Carrier rate tables ───────────────────────────────────────────────────────
# true truncates carrier_rate_tables on every boot, forcing all quotes through
# the formula adapter (estimates, not real carrier rates).
RESET_RATE_TABLE_ON_BOOT=false

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15555550100

# Same credentials under the names the legacy src/ stack reads.
EASTWOOD_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EASTWOOD_TWILIO_AUTH_TOKEN=your_twilio_auth_token
EASTWOOD_TWILIO_FROM_NUMBER=+15555550100

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Public callback URL ───────────────────────────────────────────────────────
# Where Twilio reaches the TwiML and media-stream endpoints. Must be https and
# publicly resolvable. Leave blank to create sessions without placing calls.
PUBLIC_BASE_URL=

# ── Webhook and API security ──────────────────────────────────────────────────
# Every /twiml/* and /twilio/* request must carry a valid X-Twilio-Signature
# computed over the public URL. false is a development-only escape hatch:
# production refuses to boot with it off, and a loud warning logs at startup.
TWILIO_SIGNATURE_VALIDATION_ENABLED=true

# Bearer key for eastwood-core's operational /api routes; ai-agent sends the
# same value as `Authorization: Bearer <key>`. Generate a long random secret
# (e.g. `openssl rand -hex 32`). Empty means every /api request is refused;
# production refuses to boot without one.
EASTWOOD_API_KEY=

# ── Live transfer ─────────────────────────────────────────────────────────────
# Receives the hot-transfer SMS brief. Leave blank to disable live transfer.
RYAN_PHONE_NUMBER=

# ── Appointment handoff ───────────────────────────────────────────────────────
# Where the licensed agent receives the prospect brief when an appointment books.
# If unset, booking still succeeds; the brief is skipped and the profile is
# persisted for later retrieval.
AGENT_NOTIFICATION_PHONE_E164=

# ── CMS quoting (Medicare) ────────────────────────────────────────────────────
CMS_MA_DATASET_ID=pjlv-rqvd
CMS_MS_DATASET_ID=
CMS_TARGET_CARRIERS=aetna,humana,cvs
QUOTE_TIMEOUT_SECONDS=6.0

# ── Postgres ──────────────────────────────────────────────────────────────────
# docker-compose currently hardcodes the postgres service password; this is here
# for deployments that point at an external database.
POSTGRES_PASSWORD=change_me
