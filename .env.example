# Eastwood environment template.
#
#   cp .env.example .env    then fill in real values.
#
# .env is gitignored. Never commit real credentials.
# Every value below is a placeholder or a safe default.

# ── Deployment ────────────────────────────────────────────────────────────────
# "production" enables the compliance boot guard in eastwood-core:
# starting with APP_ENV=production and BYPASS_TCPA=true is refused.
APP_ENV=development

# ── Compliance ────────────────────────────────────────────────────────────────
# BYPASS_TCPA skips the 8am-9pm local-time calling-window check. Local testing
# only. Leaving this true in production is a TCPA violation per dialed lead.
BYPASS_TCPA=false

# ── Lead scoring ──────────────────────────────────────────────────────────────
# Leads at or above HOT auto-dial; WARM auto-dials with express written consent.
# Lowering these to the same value makes every consented lead auto-dial.
SCORE_HOT_THRESHOLD=75
SCORE_WARM_THRESHOLD=50

# ── Carrier rate tables ───────────────────────────────────────────────────────
# true truncates carrier_rate_tables on every boot, forcing all quotes through
# the formula adapter (estimates, not real carrier rates).
RESET_RATE_TABLE_ON_BOOT=false

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15555550100

# Same credentials under the names the legacy src/ stack reads.
EASTWOOD_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EASTWOOD_TWILIO_AUTH_TOKEN=your_twilio_auth_token
EASTWOOD_TWILIO_FROM_NUMBER=+15555550100

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Public callback URL ───────────────────────────────────────────────────────
# Where Twilio reaches the TwiML and media-stream endpoints. Must be https and
# publicly resolvable. Leave blank to create sessions without placing calls.
PUBLIC_BASE_URL=

# ── Live transfer ─────────────────────────────────────────────────────────────
# Receives the hot-transfer SMS brief. Leave blank to disable live transfer.
RYAN_PHONE_NUMBER=

# ── CMS quoting (Medicare) ────────────────────────────────────────────────────
CMS_MA_DATASET_ID=pjlv-rqvd
CMS_MS_DATASET_ID=
CMS_TARGET_CARRIERS=aetna,humana,cvs
QUOTE_TIMEOUT_SECONDS=6.0

# ── Postgres ──────────────────────────────────────────────────────────────────
# docker-compose currently hardcodes the postgres service password; this is here
# for deployments that point at an external database.
POSTGRES_PASSWORD=change_me
