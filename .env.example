# Eastwood environment template.
#
#   cp .env.example .env    then fill in real values.
#
# .env is gitignored. Never commit real credentials.
# Every value below is a placeholder or a safe default.

# ── Deployment ────────────────────────────────────────────────────────────────
# "production" enables the compliance boot guard in eastwood-core:
# starting with APP_ENV=production and BYPASS_TCPA=true is refused.
APP_ENV=development

# ── Compliance ────────────────────────────────────────────────────────────────
# BYPASS_TCPA skips the 8am-9pm local-time calling-window check. Local testing
# only. Leaving this true in production is a TCPA violation per dialed lead.
BYPASS_TCPA=false

# ── National DNC Registry ─────────────────────────────────────────────────────
# A lead may only be auto-dialed when its national_dnc_status is "clear" or
# "exempt". New leads default to "unknown", which is not dialable.
#
# "local_csv" is a blocklist-only stand-in. It can prove a number IS on the
# registry; it cannot attest that one is clear, so on its own it dials nobody.
# Point DNC_SCRUB_PROVIDER at a real registry provider before going live.
# local_csv: blocklist-only stand-in. ftc_registry: official downloaded dataset.
DNC_SCRUB_PROVIDER=local_csv
# local_csv blocklist. Gitignored. Never commit National Registry data.
NATIONAL_DNC_BLOCKLIST_PATH=data/private/national_dnc_blocked.local.csv

# ── ftc_registry provider ─────────────────────────────────────────────────────
# Subscription Account Number and login. Secrets — only a fingerprint is stored.
DNC_SAN=
DNC_REGISTRY_USERNAME=
DNC_REGISTRY_PASSWORD=
# Comma-separated subscribed area codes, e.g. 313,248,586
DNC_AREA_CODES=
# Documented FTC automated-download endpoint (operator-supplied; not scraped).
DNC_REGISTRY_DOWNLOAD_URL=
# Downloaded dataset lives here — under data/private, gitignored.
DNC_DATA_DIRECTORY=data/private/dnc_registry
# A dataset older than this can no longer clear a number. Refresh more often.
DNC_MAX_DATA_AGE_DAYS=31

# Comma-separated E.164 numbers you personally own and consent to be called for
# end-to-end testing. These scrub as "exempt" without a provider — NOT a bypass;
# every other number still fails closed. MUST be empty in production (the boot
# guard refuses to start otherwise).
# DNC_TEST_ALLOWLIST=+15555550100

# ── SMS-first engine (docs/sms-first-engine.md) ───────────────────────────────
# Your agency exactly as the consent names it; texts identify you by it.
AGENCY_DISPLAY_NAME=Eastwood Insurance
# How texts refer to the licensed agent.
AGENT_DISPLAY_NAME=our licensed agent
# none = rule-based reading only (no AI cost); openai = gpt-5-mini reads only
# replies the rules cannot (needs OPENAI_API_KEY). It never writes a text.
SMS_LLM_PROVIDER=none
SMS_FOLLOWUP_HOURS=48,120
SMS_STALL_HOURS=24,72
SMS_REMINDER_HOURS=24,2
SMS_REPLY_OUTSIDE_HOURS=false
# Global text rate; keep it under your 10DLC throughput.
SMS_MESSAGES_PER_MINUTE=60
# Cost guard: Imogen hands off to the agent after this many texts in one conversation.
SMS_MAX_OUTBOUND_PER_CONVERSATION=30
SMS_OFFER_HOLD_MINUTES=15
COST_SMS_INBOUND_PER_SEGMENT_USD=0.0100
# Prospects see only premiums from VERIFIED carrier rate sheets (scripts/rates.py).
PROSPECT_QUOTES_REQUIRE_VERIFIED=true
# Synthetic test rate sheets / scripted SMS prospects: testing only (production refuses both).
ALLOW_TEST_RATE_SHEETS=false
SIMULATED_SMS_PROSPECTS=false
# Scanned-PDF rows below this OCR confidence are imported quarantined.
OCR_MIN_CONFIDENCE=85

# ── Outbound campaign arm switch ──────────────────────────────────────────────
# false: nothing prospect-facing leaves the system (no dial, follow-up SMS or
# callback, consent request, or booking confirmation), whatever else is set.
# true only PERMITS outbound. An operator must still authorize the campaign at
# runtime, and can halt it at any moment (both require the API key):
#   POST /api/outbound/resume  {"operator": "...", "reason": "..."}
#   POST /api/outbound/halt    {"operator": "...", "reason": "..."}
#   GET  /api/outbound/status
# A fresh deployment has never been authorized and stays halted.
OUTBOUND_ENABLED=false

# ── Campaign scope and dialer limits ──────────────────────────────────────────
# Comma-separated two-letter state codes (50 states + DC). Leads outside these
# states lose their state-fit points and usually route to nurture. Unknown codes
# are rejected at startup.
ACTIVE_STATES=MI
# Hard cap on simultaneous outbound calls; use 1 for a first live campaign.
MAX_CONCURRENT_CALLS=3
# Total attempts per lead (retry ladder 4/24/32/56/80 hours).
DIAL_MAX_ATTEMPTS=5

# ── Consent authorization (bulk import + API leads) ──────────────────────────
# Your agency's name(s) exactly as consent disclosures state them. TCPA consent
# is seller-specific: consent given to another company (e.g. a former
# employer) does not authorize your AI-voice calls or marketing texts.
CONSENT_AUTHORIZED_SELLERS=
# Quarantine consent older than this many days (0 = no age limit).
CONSENT_MAX_AGE_DAYS=0
# Third-party enrichment sends lead names to OpenFEC/NPPES. Off by default.
ENRICHMENT_ENABLED=false

# ── Spend ceilings and provider limits ────────────────────────────────────────
# Estimated outbound spend allowed per calendar day (agent's timezone).
OUTBOUND_DAILY_SPEND_LIMIT_USD=25
# Call initiations per minute across all campaigns (Twilio default ~1/second).
DIAL_CALLS_PER_MINUTE=30
# Unit prices used for estimates — reconcile with your invoices.
COST_VOICE_PER_MIN_USD=0.014
COST_AI_PER_MIN_USD=0.15
COST_TRANSCRIBE_PER_MIN_USD=0.006
COST_SMS_PER_SEGMENT_USD=0.013
COST_RESERVE_PER_CALL_USD=1.75
# Twilio ends any call after this many minutes; it also caps what one call can
# cost, which makes the budget ceilings hard limits.
MAX_CALL_MINUTES=15
# Hold dialing while your calendar (AGENT_AVAILABILITY) has no open slot.
PAUSE_DIALING_WHEN_CALENDAR_FULL=true
# twilio | simulated (load testing only; production refuses it)
TELEPHONY_PROVIDER=twilio

# ── Your own appointment calendar ─────────────────────────────────────────────
# Weekly availability in CALENDLY_DEFAULT_TIMEZONE, e.g.
#   AGENT_AVAILABILITY=mon-fri 17:00-20:00; sat 09:00-12:00
# Empty = no local calendar (Calendly if enabled, else a free-form request).
CALENDLY_DEFAULT_TIMEZONE=America/Detroit
AGENT_AVAILABILITY=
APPOINTMENT_SLOT_MINUTES=30
APPOINTMENT_BUFFER_MINUTES=0
APPOINTMENT_MAX_PER_DAY=4
APPOINTMENT_MIN_NOTICE_HOURS=2
APPOINTMENT_HORIZON_DAYS=14
AGENT_BLACKOUT_DATES=

# ── Lead scoring ──────────────────────────────────────────────────────────────
# Leads at or above HOT auto-dial; WARM auto-dials with express written consent.
# Lowering these to the same value makes every consented lead auto-dial.
SCORE_HOT_THRESHOLD=75
SCORE_WARM_THRESHOLD=50

# ── Carrier rate tables ───────────────────────────────────────────────────────
# true truncates carrier_rate_tables on every boot, forcing all quotes through
# the formula adapter (estimates, not real carrier rates).
RESET_RATE_TABLE_ON_BOOT=false

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15555550100

# Same credentials under the names the legacy src/ stack reads.
EASTWOOD_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EASTWOOD_TWILIO_AUTH_TOKEN=your_twilio_auth_token
EASTWOOD_TWILIO_FROM_NUMBER=+15555550100

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Public callback URL ───────────────────────────────────────────────────────
# Where Twilio reaches the TwiML and media-stream endpoints. Must be https and
# publicly resolvable. Leave blank to create sessions without placing calls.
PUBLIC_BASE_URL=

# ── Webhook and API security ──────────────────────────────────────────────────
# Every /twiml/* and /twilio/* request must carry a valid X-Twilio-Signature
# computed over the public URL. false is a development-only escape hatch:
# production refuses to boot with it off, and a loud warning logs at startup.
TWILIO_SIGNATURE_VALIDATION_ENABLED=true

# Bearer key for eastwood-core's operational /api routes; ai-agent sends the
# same value as `Authorization: Bearer <key>`. Generate a long random secret
# (e.g. `openssl rand -hex 32`). Empty means every /api request is refused;
# production refuses to boot without one.
EASTWOOD_API_KEY=

# ── Live transfer ─────────────────────────────────────────────────────────────
# Receives the hot-transfer SMS brief. Leave blank to disable live transfer.
RYAN_PHONE_NUMBER=

# ── Appointment handoff ───────────────────────────────────────────────────────
# Where the licensed agent receives the prospect brief when an appointment books.
# If unset, booking still succeeds; the brief is skipped and the profile is
# persisted for later retrieval.
AGENT_NOTIFICATION_PHONE_E164=

# ── CMS quoting (Medicare) ────────────────────────────────────────────────────
CMS_MA_DATASET_ID=pjlv-rqvd
CMS_MS_DATASET_ID=
CMS_TARGET_CARRIERS=aetna,humana,cvs
QUOTE_TIMEOUT_SECONDS=6.0

# ── Postgres ──────────────────────────────────────────────────────────────────
# docker-compose currently hardcodes the postgres service password; this is here
# for deployments that point at an external database.
POSTGRES_PASSWORD=change_me
