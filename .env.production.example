# Eastwood PRODUCTION environment template.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#   docker compose -p eastwood-prod --env-file .env.production \
#     -f docker-compose.yml -f docker-compose.production.yml up -d --build
#
# Separate from the development .env on purpose: the dev stack keeps working
# unchanged, and a production deployment never inherits a dev escape hatch.
# .env.production is gitignored. Never commit real values.
#
# Every blank below is REQUIRED — docker compose refuses to start until it is
# set, and eastwood-core's boot guard re-checks the values that reach it.
# See docs/go-live-checklist.md and docs/launch-dependencies-and-costs.md.

# ── Internal secrets (generate locally; not third-party credentials) ──────────
# openssl rand -hex 32
EASTWOOD_API_KEY=
# openssl rand -hex 24   (hex only: it is embedded in database URLs)
POSTGRES_PASSWORD=
# openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=

# ── Public webhook origin ─────────────────────────────────────────────────────
# Stable HTTPS URL that reaches nginx (127.0.0.1:18000) through your TLS proxy
# or named tunnel. Temporary tunnels (ngrok, trycloudflare, localtunnel),
# localhost and plain http are refused at boot.
PUBLIC_BASE_URL=

# ── National DNC Registry (FTC) ───────────────────────────────────────────────
DNC_SAN=
DNC_REGISTRY_USERNAME=
DNC_REGISTRY_PASSWORD=
# Every area code in the lead list, comma-separated, e.g. 313,248,586
DNC_AREA_CODES=
DNC_REGISTRY_DOWNLOAD_URL=
DNC_MAX_DATA_AGE_DAYS=31

# ── Twilio (rotated credentials only) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── OpenAI (rotated key only) ─────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Licensed agent handoff ────────────────────────────────────────────────────
AGENT_NOTIFICATION_PHONE_E164=
RYAN_PHONE_NUMBER=

# ── Campaign scope ────────────────────────────────────────────────────────────
# Every state the campaign may dial; unknown codes are refused at boot.
ACTIVE_STATES=
# Documented launch thresholds — the boot guard refuses anything lower.
SCORE_HOT_THRESHOLD=75
SCORE_WARM_THRESHOLD=50
MAX_CONCURRENT_CALLS=1
DIAL_MAX_ATTEMPTS=5

# ── Consent, spend and calendar ───────────────────────────────────────────────
# Your agency exactly as consent disclosures name it (required).
CONSENT_AUTHORIZED_SELLERS=
CONSENT_MAX_AGE_DAYS=0
# Hard daily ceiling on estimated outbound spend (required).
OUTBOUND_DAILY_SPEND_LIMIT_USD=25
DIAL_CALLS_PER_MINUTE=30
# Twilio ends any call after this many minutes (bounds one call's cost).
MAX_CALL_MINUTES=15
PAUSE_DIALING_WHEN_CALENDAR_FULL=true
# Your part-time hours, e.g. "mon-fri 17:00-20:00; sat 09:00-12:00"
CALENDLY_DEFAULT_TIMEZONE=America/Detroit
AGENT_AVAILABILITY=
APPOINTMENT_MAX_PER_DAY=4

# Tenant this deployment works. Leave as 'default'; the controlled live test
# (docs/operator-runbook.md section 4) temporarily uses 'live-test-1'.
DEFAULT_TENANT_ID=default

# ── SMS-first engine (docs/sms-first-engine.md) ───────────────────────────────
# Your agency exactly as the consent names it; texts identify you by it (required).
AGENCY_DISPLAY_NAME=
# How texts refer to the licensed agent.
AGENT_DISPLAY_NAME=our licensed agent
# none = rule-based reading only (no AI cost); openai = gpt-5-mini reads only
# replies the rules cannot (needs OPENAI_API_KEY). It never writes a text.
SMS_LLM_PROVIDER=none
SMS_FOLLOWUP_HOURS=48,120
SMS_STALL_HOURS=24,72
SMS_REMINDER_HOURS=24,2
SMS_REPLY_OUTSIDE_HOURS=false
# Global text rate; keep it under your 10DLC throughput.
SMS_MESSAGES_PER_MINUTE=20
# Cost guard: Imogen hands off to the agent after this many texts in one conversation.
SMS_MAX_OUTBOUND_PER_CONVERSATION=30
SMS_OFFER_HOLD_MINUTES=15
COST_SMS_INBOUND_PER_SEGMENT_USD=0.0100
# Prospects see only premiums from VERIFIED carrier rate sheets (scripts/rates.py).
PROSPECT_QUOTES_REQUIRE_VERIFIED=true
# (ALLOW_TEST_RATE_SHEETS and SIMULATED_SMS_PROSPECTS are pinned false by the production overlay.)
# Scanned-PDF rows below this OCR confidence are imported quarantined.
OCR_MIN_CONFIDENCE=85

# ── Outbound arm switch ───────────────────────────────────────────────────────
# Leave false until the go-live checklist is complete. Even when true, nothing
# is contacted until an operator authorizes the campaign:
#   POST /api/outbound/resume {"operator": "...", "reason": "..."}
# and POST /api/outbound/halt stops it immediately.
OUTBOUND_ENABLED=false

# ── Optional integrations ─────────────────────────────────────────────────────
CALENDLY_ENABLED=false
CALENDLY_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
